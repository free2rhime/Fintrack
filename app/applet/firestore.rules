rules_version = '2';

// FinTrack Firestore Security Rules
//
// SYSTEM ARCHITECTURE & SECURITY BOUNDARIES:
// 1. Mobile Client Auth: All mobile requests are authenticated via Firebase Auth (request.auth).
// 2. Household Isolation: Data access is scoped strictly to active members of households/$(householdId)/members/$(request.auth.uid).
// 3. Self-Join Prevention: Users CANNOT add themselves to households by writing member documents.
//    Only household admins/owners can add/update members, or the household creator initializing their owner doc.
// 4. Server/Service Account Access (Google Sheets Integration):
//    Server-side integrations and Google Sheets sync services MUST use Firebase Admin SDK or Google Cloud IAM service accounts.
//    Firebase Admin SDK bypasses security rules entirely. Mobile rules strictly evaluate client request.auth context.
// 5. Floating-Point Limitation Note:
//    Firestore Security Rules do NOT support complex or reliable floating-point arithmetic / division verification.
//    Currency conversion calculations (e.g. amountRon = amount * rate) MUST be validated in application/domain code.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions

    function isAuthenticated() {
      return request.auth != null;
    }

    function getMemberData(householdId, uid) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(uid)).data;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)) &&
        getMemberData(householdId, request.auth.uid).status == 'ACTIVE';
    }

    function isHouseholdAdminOrOwner(householdId) {
      return isHouseholdMember(householdId) &&
        (getMemberData(householdId, request.auth.uid).role in ['owner', 'admin']);
    }

    function isHouseholdOwner(householdId) {
      return isHouseholdMember(householdId) &&
        getMemberData(householdId, request.auth.uid).role == 'owner';
    }

    function isHouseholdCreator(householdId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/households/$(householdId)) &&
        get(/databases/$(database)/documents/households/$(householdId)).data.createdByUid == request.auth.uid;
    }

    // Domain validation helpers

    function isValidTransactionType(type) {
      return type in ['Income', 'Expense'];
    }

    function isValidAccount(account) {
      return account in ['Card', 'Cash', 'Meal Tickets'];
    }

    function isValidDestination(type, destination) {
      return (type == 'Income' && (destination in ['Bubu', 'Piticania'] || destination == null)) ||
             (type == 'Expense' && destination == null);
    }

    function isValidConversionMetadata(meta, transactionDate) {
      return meta == null || (
        meta.source == 'BNR_OFFICIAL' &&
        meta.status == 'OFFICIAL' &&
        meta.rate is number && meta.rate > 0 &&
        meta.effectiveDate is string &&
        meta.effectiveDate <= transactionDate
      );
    }

    function isTransactionValid(data) {
      return data.transactionId is string &&
             data.householdId is string &&
             data.createdByUid is string &&
             isValidTransactionType(data.type) &&
             isValidAccount(data.account) &&
             isValidDestination(data.type, data.destination) &&
             isValidConversionMetadata(
               data.keys().contains('exchangeRateMetadata') ? data.exchangeRateMetadata : null,
               data.transactionDate
             );
    }

    function isTransactionUpdateValid(existing, incoming) {
      return incoming.transactionId == existing.transactionId &&
             incoming.householdId == existing.householdId &&
             incoming.createdByUid == existing.createdByUid &&
             isTransactionValid(incoming);
    }

    // Default deny for unauthenticated or non-matching paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Household root collection
    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create: if isAuthenticated() &&
                       request.resource.data.createdByUid == request.auth.uid;
      allow update: if isHouseholdAdminOrOwner(householdId) &&
                       request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if isHouseholdOwner(householdId);

      // Members subcollection
      match /members/{uid} {
        allow read: if isHouseholdMember(householdId);

        // Prevent self-join: Only admin/owner can add members, OR the household creator initializing their owner doc
        allow create: if isHouseholdAdminOrOwner(householdId) ||
                         (isHouseholdCreator(householdId) &&
                          uid == request.auth.uid &&
                          request.resource.data.role == 'owner' &&
                          request.resource.data.status == 'ACTIVE');

        // Only admin/owner can update or remove members
        allow update, delete: if isHouseholdAdminOrOwner(householdId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) &&
                         request.resource.data.householdId == householdId &&
                         request.resource.data.createdByUid == request.auth.uid &&
                         isTransactionValid(request.resource.data);
        allow update: if isHouseholdMember(householdId) &&
                         isTransactionUpdateValid(resource.data, request.resource.data);
        allow delete: if isHouseholdMember(householdId) &&
                         (resource.data.createdByUid == request.auth.uid || isHouseholdAdminOrOwner(householdId));
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) &&
                         request.resource.data.householdId == householdId &&
                         isValidTransactionType(request.resource.data.type);
        allow update: if isHouseholdMember(householdId) &&
                         request.resource.data.householdId == resource.data.householdId;
        allow delete: if isHouseholdAdminOrOwner(householdId);
      }

      // Exchange Rates subcollection
      match /exchangeRates/{requestedDate} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId) &&
                                 request.resource.data.source == 'BNR_OFFICIAL' &&
                                 request.resource.data.status == 'OFFICIAL';
        allow delete: if isHouseholdAdminOrOwner(householdId);
      }
    }
  }
}
